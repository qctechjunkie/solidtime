# ==============================================================================
# SOLIDTIME - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to a new file named ".env"
# 2. Modify the values below to suit your environment
# 3. Generate required secrets (see Authentication section below)
# 4. DO NOT commit your final ".env" file to source control
#
# Full configuration reference:
#   https://docs.solidtime.io/self-hosting/configuration
# ==============================================================================

# ==============================================================================
# 1. DATA STORAGE
# ==============================================================================
# Absolute path on the host where all persistent data is stored.
# Subdirectories are managed automatically by Docker:
#   <DOCKER_DATA_PATH>/logs        — Application log files
#   <DOCKER_DATA_PATH>/app-storage — Application file uploads and cache
#
# Linux: create the dirs and set ownership to UID/GID 1000 before first start:
#   mkdir -p /home/docker/solidtime/{logs,app-storage}
#   chown -R 1000:1000 /home/docker/solidtime/{logs,app-storage}
# ==============================================================================
DOCKER_DATA_PATH=/home/docker/solidtime

# ==============================================================================
# 2. IMAGE
# ==============================================================================
# Tag to pull from Docker Hub. Pin to a specific version in production.
#   latest — always pulls the newest release
# ==============================================================================
SOLIDTIME_IMAGE_TAG=latest

# ==============================================================================
# 3. NETWORK
# ==============================================================================
# Host port to expose the Solidtime web interface on.
PORT=8000

# ==============================================================================
# 4. APPLICATION
# ==============================================================================
# Public URL of your Solidtime instance (no trailing slash).
# Used for link generation, OAuth redirects, and HTTPS enforcement.
APP_URL=https://your-domain.com

# Set to true when running behind a reverse proxy (Nginx, Traefik, Caddy).
# Ensures HTTP requests are treated as HTTPS internally.
APP_FORCE_HTTPS=true

# Trusted reverse proxy CIDR ranges (comma-separated).
# Default covers all IPv4 and IPv6 — restrict to your proxy IPs in production.
TRUSTED_PROXIES=0.0.0.0/0,2000:0:0:0:0:0:0:0/3

# Allow new user self-registration. Set to false for invite-only mode.
APP_ENABLE_REGISTRATION=true

# Deployment environment. Do not change unless running a development instance.
APP_ENV=production
APP_DEBUG=false

# ==============================================================================
# 5. AUTHENTICATION  (REQUIRED — generate before first start)
# ==============================================================================
# Application encryption key. Generate with:
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# OAuth2 server keys. Generate with openssl (see README) — paste the single-line output here.
# Values must be a single line with literal \n escape sequences (no actual newlines).
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# Comma-separated list of email addresses granted super-admin panel access.
# Leave empty to disable the super-admin panel.
SUPER_ADMINS=

# ==============================================================================
# 6. LOGGING
# ==============================================================================
# LOG_CHANNEL: stderr_daily (recommended) | daily | stderr
# LOG_LEVEL:   debug | info | notice | warning | error | critical
# ==============================================================================
LOG_CHANNEL=stderr_daily
LOG_LEVEL=info

# ==============================================================================
# 7. DATABASE (PostgreSQL — Global Instance)
# ==============================================================================
# These credentials connect to the shared global-postgres instance on Pi 2.
# DB_HOST must match POSTGRES_CONTAINER_NAME in global-postgres .env.
# Generate a secure password with: openssl rand -hex 32
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=pi2-postgres
DB_PORT=5432
DB_DATABASE=solidtime
DB_USERNAME=solidtime
DB_PASSWORD=

# SSL mode for the database connection.
# Use 'disable' for the internal Docker Postgres container.
# Use 'require' when connecting to an external or cloud-hosted database.
DB_SSLMODE=disable

# Docker network shared with global-postgres (must match NETWORK_NAME in global-postgres .env)
POSTGRES_NETWORK_NAME=pi2-postgres-network

# ==============================================================================
# 8. EMAIL / SMTP  (OPTIONAL)
# ==============================================================================
# Required for password reset emails and notifications.
# Set MAIL_MAILER=log to disable outbound email (useful for testing).
# ==============================================================================
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-domain.com
MAIL_FROM_NAME=solidtime
MAIL_USERNAME=
MAIL_PASSWORD=

# ==============================================================================
# 9. QUEUE
# ==============================================================================
# database — jobs are stored in PostgreSQL (default, no extra infrastructure)
# sync      — jobs run inline (not recommended for production)
# ==============================================================================
QUEUE_CONNECTION=database

# ==============================================================================
# 10. FILE STORAGE
# ==============================================================================
# Local storage (default) — files stored inside the app-storage volume.
FILESYSTEM_DISK=local
PUBLIC_FILESYSTEM_DISK=public

# ==============================================================================
# 11. PDF RENDERING
# ==============================================================================
# Internal Gotenberg service URL — do not change unless using an external instance.
GOTENBERG_URL=http://gotenberg:3000
